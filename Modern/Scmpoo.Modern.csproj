<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Scmpoo.Modern</AssemblyName>
    <RootNamespace>Scmpoo.Modern</RootNamespace>
    <ApplicationIcon>../Scmpoo/100.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0</Version>
    <DefineConstants>$(DefineConstants);MODERN_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Scmpoo/*.bmp;../Scmpoo/*.wav;../Scmpoo/100.ico">
      <LogicalName>Scmpoo.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
